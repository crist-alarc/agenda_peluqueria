{
  "name": "agenda",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agenda/web dev",
    "build": "pnpm --filter @agenda/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=!@agenda/db test",
    "test:db": "pnpm --filter @agenda/db test"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
